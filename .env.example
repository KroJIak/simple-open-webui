WEBUI_NAME='Open WebUI'
USER_AGENT='Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36'
DEFAULT_PROMPT_SUGGESTIONS=[]
ENABLE_PROMPT_SUGGESTIONS=false
ENABLE_CHANNELS=true
ENABLE_PUBLIC_ACTIVE_USERS_COUNT=false
ENABLE_EVALUATION_ARENA_MODELS=false
ENABLE_CALENDAR=false
ENABLE_AUTOMATIONS=false
ENABLE_CODE_EXECUTION=false
ENABLE_CODE_INTERPRETER=true
CODE_INTERPRETER_ENGINE=pyodide
ENABLE_ADMIN_CHAT_ACCESS=false
ENABLE_ADMIN_EXPORT=false
USER_PERMISSIONS_WORKSPACE_KNOWLEDGE_ACCESS=true
USER_PERMISSIONS_WORKSPACE_PROMPTS_ACCESS=true
USER_PERMISSIONS_WORKSPACE_SKILLS_ACCESS=true
ENABLE_WEB_SEARCH=true
ENABLE_NATIVE_PROVIDER_WEB_SEARCH=true
WEB_SEARCH_ENGINE=duckduckgo
DDGS_BACKEND=all
WEB_SEARCH_RESULT_COUNT=3
WEB_SEARCH_CONCURRENT_REQUESTS=1
ENABLE_BASE_MODELS_CACHE=true
HIDE_NEW_MODELS_BY_DEFAULT=true
AIOHTTP_CLIENT_TIMEOUT_MODEL_LIST=30
AIOHTTP_CLIENT_READ_BUFSIZE=8388608
AIOHTTP_CLIENT_MAX_LINE_SIZE=16777216
AIOHTTP_CLIENT_MAX_FIELD_SIZE=65536
BYPASS_WEB_SEARCH_WEB_LOADER=true
BYPASS_WEB_SEARCH_EMBEDDING_AND_RETRIEVAL=true
WEB_LOADER_TIMEOUT=8
ENABLE_SEARCH_QUERY_GENERATION=true
CLIPROXYAPI_PORT=18317
CLIPROXYAPI_API_KEY=change-me-to-a-long-random-secret
CLIPROXYAPI_MANAGEMENT_KEY=change-me-to-a-different-long-random-secret
CLIPROXYAPI_UPSTREAM_BASE_URL=https://codex.sale/v1
CLIPROXYAPI_UPSTREAM_API_KEY=
# API key from Open WebUI (Settings -> Account) used by model-syncer to seed new models; leave empty to disable seeding
OPENWEBUI_API_KEY=

## Image generation (OpenAI-compatible /images/generations endpoint) ##
ENABLE_IMAGE_GENERATION=true
IMAGE_GENERATION_ENGINE=openai
# Image model(s): either a single model, or a comma separated chain that is
# tried in order (the first entry is the primary, the rest are fallbacks).
# For cheapvibecode.ru the working models are:
#   gpt-image-2.6-sunburst (~85s), gpt-image-2.6-flare (~70s),
#   gpt-image-2.5-sunburst (~100s), gpt-image-2 (~25s, fastest / lowest quality)
# The provider rejects gpt-image-2.5 and gpt-image-2.6 without a variant suffix.
IMAGE_GENERATION_MODEL=gpt-image-2.6-sunburst,gpt-image-2.6-flare,gpt-image-2.5-sunburst,gpt-image-2
IMAGE_SIZE=1024x1024
# How many images of the chat history are sent to the model provider.
# Every request resends the whole history, so this is the safety net for
# pathological chats. The images are downscaled first (MAX_IMAGE_SIDE),
# which is what keeps the request fast. 0 = no limit.
MAX_IMAGES_PER_REQUEST=50
# Images bigger than this (in pixels) are downscaled before they are sent to the
# provider - the model sees the same picture, the provider decodes it much faster.
MAX_IMAGE_SIDE=512
IMAGE_COMPRESSION_QUALITY=60

# Token budget of a chat request. Every request resends the whole history, so
# a long chat gets slower and more expensive with every message. When the
# history exceeds the budget, the oldest messages are condensed into a short
# digest. 0 = no limit.
CONTEXT_TOKEN_BUDGET=100000

# The condensation happens in blocks of this many messages, so that the
# condensed prefix only changes every few messages and the prompt cache of
# the provider stays valid.
CONTEXT_COMPACTION_BLOCK=20

# The newest messages are never condensed away.
CONTEXT_KEEP_RECENT_MESSAGES=20

# The token estimate is based on tiktoken, but the providers count with their
# own tokenizer. This factor calibrates the estimate against the accounting
# of the provider (1.0 = use the raw tiktoken estimate).
CONTEXT_TOKEN_ESTIMATE_FACTOR=0.8
ENABLE_IMAGE_PROMPT_GENERATION=true
IMAGES_OPENAI_API_BASE_URL=https://cheapvibecode.ru/v1
IMAGES_OPENAI_API_KEY=

## Embeddings (OpenAI-compatible /embeddings endpoint) ##
# Local embedding models (sentence-transformers/torch) are not installed in this
# build. Point RAG_EMBEDDING_ENGINE at an OpenAI-compatible provider to enable
# the knowledge base / RAG features.
RAG_EMBEDDING_ENGINE=openai
RAG_OPENAI_API_BASE_URL=
RAG_OPENAI_API_KEY=
# Embedding model id, e.g. text-embedding-3-small / text-embedding-3-large
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_BATCH_SIZE=1
ENABLE_ASYNC_EMBEDDING=true
RAG_EMBEDDING_CONCURRENT_REQUESTS=0

DATABASE_URL=
# Example for external PostgreSQL:
# DATABASE_URL=postgresql://openwebui:change-me@postgres:5432/openwebui
# In Dokploy, use the database service hostname on the shared dokploy-network.
VITE_BUILD_SOURCEMAP=false
WEBUI_SECRET_KEY=change-me-to-a-long-random-secret
