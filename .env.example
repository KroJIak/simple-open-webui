WEBUI_NAME='Open WebUI'
USER_AGENT='Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36'
DEFAULT_PROMPT_SUGGESTIONS=[]
ENABLE_PROMPT_SUGGESTIONS=false
ENABLE_CHANNELS=true
ENABLE_PUBLIC_ACTIVE_USERS_COUNT=false
ENABLE_OLLAMA_API=false
ENABLE_EVALUATION_ARENA_MODELS=false
ENABLE_CALENDAR=false
ENABLE_AUTOMATIONS=false
ENABLE_CODE_EXECUTION=false
ENABLE_CODE_INTERPRETER=true
CODE_INTERPRETER_ENGINE=pyodide
ENABLE_ADMIN_CHAT_ACCESS=false
ENABLE_ADMIN_EXPORT=false
USER_PERMISSIONS_WORKSPACE_KNOWLEDGE_ACCESS=true
USER_PERMISSIONS_WORKSPACE_PROMPTS_ACCESS=true
USER_PERMISSIONS_WORKSPACE_SKILLS_ACCESS=true
ENABLE_WEB_SEARCH=true
ENABLE_NATIVE_PROVIDER_WEB_SEARCH=true
WEB_SEARCH_ENGINE=duckduckgo
DDGS_BACKEND=all
WEB_SEARCH_RESULT_COUNT=3
WEB_SEARCH_CONCURRENT_REQUESTS=1
ENABLE_BASE_MODELS_CACHE=true
AIOHTTP_CLIENT_TIMEOUT_MODEL_LIST=30
AIOHTTP_CLIENT_READ_BUFSIZE=8388608
AIOHTTP_CLIENT_MAX_LINE_SIZE=16777216
AIOHTTP_CLIENT_MAX_FIELD_SIZE=65536
BYPASS_WEB_SEARCH_WEB_LOADER=true
BYPASS_WEB_SEARCH_EMBEDDING_AND_RETRIEVAL=true
WEB_LOADER_TIMEOUT=8
ENABLE_SEARCH_QUERY_GENERATION=true
CLIPROXYAPI_PORT=18317
CLIPROXYAPI_MANAGEMENT_PORT=18085
CLIPROXYAPI_API_KEY=change-me-to-a-long-random-secret
CLIPROXYAPI_MANAGEMENT_KEY=change-me-to-a-different-long-random-secret
CLIPROXYAPI_UPSTREAM_BASE_URL=https://codex.sale/v1
CLIPROXYAPI_UPSTREAM_API_KEY=
DATABASE_URL=
WEBUI_SECRET_KEY=change-me-to-a-long-random-secret

# Optional: if you later enable Ollama API, point it to your external Ollama server
# OLLAMA_BASE_URL='http://host.docker.internal:11434'

OPENAI_API_BASE_URL=''
OPENAI_API_KEY=''

# AUTOMATIC1111_BASE_URL="http://localhost:7860"

# For production, you should only need one host as
# fastapi serves the svelte-kit built frontend and backend from the same host and port.
# To test with CORS locally, you can set something like
# CORS_ALLOW_ORIGIN='http://localhost:5173;http://localhost:8080'
CORS_ALLOW_ORIGIN='*'

# For production you should set this to match the proxy configuration (127.0.0.1)
FORWARDED_ALLOW_IPS='*'

# DO NOT TRACK
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# Valkey Vector Store (requires VECTOR_DB=valkey)
# VALKEY_URL='valkey://localhost:6379'
# VALKEY_COLLECTION_PREFIX='open_webui'
# VALKEY_INDEX_TYPE='HNSW'
# VALKEY_DISTANCE_METRIC='COSINE'
# VALKEY_HNSW_M='16'
# VALKEY_HNSW_EF_CONSTRUCTION='200'
# VALKEY_HNSW_EF_RUNTIME='10'
